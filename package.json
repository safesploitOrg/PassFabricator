{
  "name": "passfabricator",
  "version": "1.1.1",
  "description": "A client-side password generator and password strength analyser.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run coverage && npm run build",
    "audit": "npm audit --audit-level=moderate",
    "security:sast": "semgrep scan --config .semgrep.yml --error --strict --metrics=off --disable-version-check public scripts",
    "security:secrets": "gitleaks dir --redact --exit-code 1 ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
